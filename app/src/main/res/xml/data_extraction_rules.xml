<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cf_secure_prefs.xml"/>
        <exclude domain="sharedpref" path="cf_fallback_prefs.xml"/>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="datastore"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cf_secure_prefs.xml"/>
        <exclude domain="sharedpref" path="cf_fallback_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
